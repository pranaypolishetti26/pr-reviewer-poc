{
  "name": "pr-reviewer",
  "description": "Reviews PRs using approved MCP read tools and returns structured JSON for CodeBuild to publish.",
  "prompt": "file://pr-reviewer-prompt.md",
  "includeMcpJson": true,
  "welcomeMessage": "PR Reviewer ready. Provide a GitHub pull request number to review.",
  "tools": [
    "@github/pull_request_read",
    "@github/issue_read",
    "@project-knowledge/ProjectDocsLambdaTarget___search_project_docs"
  ],
  "allowedTools": [
    "@github/pull_request_read",
    "@github/issue_read",
    "@project-knowledge/ProjectDocsLambdaTarget___search_project_docs"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "builtin",
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "@github/pull_request_read",
          "@github/issue_read",
          "@project-knowledge/ProjectDocsLambdaTarget___search_project_docs",
          "github/pull_request_read",
          "github/issue_read",
          "project-knowledge/ProjectDocsLambdaTarget___search_project_docs"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "exclude": [
          "@github/pull_request_read",
          "@github/issue_read",
          "@project-knowledge/ProjectDocsLambdaTarget___search_project_docs",
          "github/pull_request_read",
          "github/issue_read",
          "project-knowledge/ProjectDocsLambdaTarget___search_project_docs"
        ],
        "effect": "deny"
      }
    ]
  },
  "includePowers": false
}
